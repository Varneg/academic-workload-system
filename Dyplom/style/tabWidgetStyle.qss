QTabBar::tab {
    background: #dcdcdc;
    border: 1px solid #999;
    padding: 8px 16px;
    font-size: 16px;
    font-weight: bold;
    margin-top: 6px;
}

QTabBar::tab:selected {
    background: #ffffff;

    margin-top: 0px;
    padding-top: 14px;
    
    border-top: 6px solid #26BBDD;
    border-left: 1px solid #8B8B8B;
    border-right: 1px solid #8B8B8B;
    border-bottom: 1px solid #ffffff;

    color: #0C94B3;
}

QTabBar::tab:selected:top {
    background: #ffffff;
    border-top: 6px solid #26BBDD;
}

QTabBar::tab:hover {
    background: #e6f2ff;
}

QTabWidget::pane {
    border: 1px solid #8B8B8B;
    top: -1px;
}